# Main MATE (Multi-Agent Tree Engine) Configuration
# Copy to .env and fill in values
AGENTS_LIST=chess_mate_root
# Authentication (Basic Auth fallback — always available)
AUTH_USERNAME=
AUTH_PASSWORD=

# OAuth 2.0 / OIDC Single Sign-On
# Leave blank to disable a provider; Basic Auth remains available regardless.
#
# Google (OIDC) — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://<your-domain>/auth/callback/google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CONF_URL=https://accounts.google.com/.well-known/openid-configuration
#
# GitHub (OAuth 2.0) — create at https://github.com/settings/developers
# Authorization callback URL: https://<your-domain>/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
#
# General OAuth settings
# SECRET_KEY=<random-32-byte-hex>         # Signs the encrypted session cookie; set in production!
# OAUTH_DEFAULT_ROLE=pending              # Role for new SSO users. Default 'pending' = no agent
#                                         # access until an admin grants a role on /dashboard/users.
#                                         # Roles: admin (full), user (dashboard agents), widget
#                                         # (public embeddable widget/trial agents — auto-assigned),
#                                         # pending (no access). Agents with NO roles set are admin-only.
# SESSION_SECURE_COOKIE=false             # Set to true behind TLS in production
# OAUTH_ALLOWED_DOMAINS=                   # Comma-separated email domains allowed to sign in via SSO.
#                                         # Empty = anyone with a provider account can create a session.
# OAUTH_ALLOWED_EMAILS=                    # Comma-separated individual emails allowed to sign in.
# TOKEN_TTL_HOURS=24                       # Lifetime of bearer tokens from POST /auth/token.

# Production Hardening
# MATE_ENV=development                    # Set to 'production' to refuse startup on insecure
#                                         # defaults (default AUTH_PASSWORD, missing SECRET_KEY)
#                                         # and to force SESSION_SECURE_COOKIE on.
# MATE_ALLOW_INSECURE_DEFAULTS=false      # Escape hatch: allow those defaults in production anyway.
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
#                                         # Comma-separated CORS allowlist. Dashboard and widget chat
#                                         # are same-origin; /widget/public-config stays open on its own.
# TRUSTED_PROXY_HOSTS=*                   # Comma-separated proxy IPs to trust for X-Forwarded-*.
#                                         # Restrict in production — "*" lets any client spoof them,
#                                         # and audit logs then fall back to the socket peer address.
# WIDGET_ORIGIN_STRICT=false               # true = reject widget requests whose Origin is not in the
#                                         # key's allowlist. false only logs what would be rejected.
#                                         # Covers the chat page, the loader's public-config call and
#                                         # the admin routes. Browser-enforced only: it stops the key
#                                         # being embedded on another site, not scripted calls with a
#                                         # forged/absent Origin — use RATE_LIMIT_ENABLED for those.
#                                         # Entries are matched on scheme+host+port; list apex and www
#                                         # separately, or use *.example.com.
# WIDGET_LEGACY_ADMIN_KEY=false            # true = the public widget key still works on /widget/api
#                                         # admin routes. Transitional only; keep false.
# CSP_MODE=report-only                     # Content-Security-Policy: report-only (log violations,
#                                         # block nothing), enforce, or off. See docs/dev/content-security-policy.md.
# CSP_EXTRA_SOURCES=                       # Extra hosts for scripts, styles, fonts, connections and
#                                         # frames, e.g. https://cdn.example.com (comma separated).

# Server Configuration
# Agent runtime framework on port ADK_PORT: adk (Google ADK, default) or langgraph
AGENT_FRAMEWORK=adk
ADK_HOST=127.0.0.1
ADK_PORT=8001
#ADK_DEV_UI=true  # ADK dev UI (/dev-ui, admins only, adk runtime). Default: on, but off when
#                 # MATE_ENV=production; set true/false to override either way
DB_TYPE=sqlite  # sqlite (default), postgresql or mysql
LOG_LEVEL=info  # debug, info, warning, error, critical
ACCESS_LOG=true  # set to false to disable HTTP request logs (GET, POST, etc.)

# PostgreSQL/MySQL settings
DB_HOST=localhost  # default localhost
DB_PORT=5432  # default 5432, or 3306 for MySQL
DB_NAME=mate_agent  # default mate_agent
DB_USER=  # required for PostgreSQL and MySQL
DB_PASSWORD=  # required for PostgreSQL and MySQL
#DB_CONNECT_RETRIES=5  # connection attempts at startup, 3s apart, for a database that starts after the app

# SQLite
DB_PATH=my_agent_data.db  # SQLite file; a relative path is taken from the project root (default my_agent_data.db)

GOOGLE_API_KEY=

# Web search for the google_search tool. With a key, results come from the
# Tavily API; without one, the tool falls back to DuckDuckGo.
TAVILY_API_KEY=

# LLM Provider API Keys
# Only set keys for providers you actually use.
# Model prefix in agent config determines which provider is used:
#   gemini-*            → Google Gemini (uses GOOGLE_API_KEY)
#   openai/gpt-4o       → OpenAI
#   anthropic/claude-*   → Anthropic
#   deepseek/deepseek-*  → DeepSeek
#   ollama_chat/model    → Local Ollama (set OLLAMA_API_BASE)
#   openrouter/provider/model → OpenRouter (aggregator)
#   mistral/*, groq/*, cohere/*, together_ai/* → respective providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Default model for the image tool when an agent names none: any LiteLLM image
# model, e.g. gpt-image-1, gemini/gemini-2.5-flash-image or black_forest_labs/flux-pro-1.1
# (needs BFL_API_KEY). The dashboard's Settings page overrides it. Unset: dall-e-3.
IMAGE_MODEL=
#IMAGE_ALLOW_PRIVATE_NETWORK=false  # let the image tool download from private/loopback addresses (a local image model)

# Ollama (local model hosting)
OLLAMA_API_BASE=http://localhost:11434

# Embedding model for semantic search over memory blocks (litellm format).
# Any litellm-supported embedding model works, e.g.:
#   gemini/gemini-embedding-001 (default, uses GOOGLE_API_KEY)
#   text-embedding-3-small (OpenAI)
#   mistral/mistral-embed
# When no key/model is available, search falls back to keyword (LIKE) matching.
# EMBEDDING_MODEL=gemini/gemini-embedding-001

# Alternative Local API Servers (defaults are used if not set)
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LLAMACPP_BASE_URL=http://localhost:8080/v1
# LOCALAI_BASE_URL=http://localhost:8080/v1
# LLAMAFILE_BASE_URL=http://localhost:8080/v1

SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=artifacts  # bucket for both Supabase artifacts and the Supabase storage tools (default artifacts); image links assume it is public

ARTIFACT_SERVICE=local_folder  # local_folder, supabase or s3; unset or none keeps artifacts in memory, lost on restart

# for gdrive mcp + Google Calendar tool (shared service account)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_INFO=

# Wizard Tier 2 (appointment scheduling) — Google Calendar via the service account above.
# Customers share their calendar with the service account email; the agent's tool config points
# at that calendar id. Trials use a demo calendar so no customer credentials are needed.
# WIZARD_DEMO_CALENDAR_ID=                 # Calendar id used by trial agents (default: SA 'primary')
# WIZARD_CALENDAR_TIMEZONE=Europe/Belgrade # Timezone for created events (naive datetimes are normalized to it)
# WIZARD_DEFAULT_SLOT_MIN=30                # Default appointment length (min) when not set per agent
# WIZARD_ANALYSIS_MODEL=openrouter/google/gemini-2.5-flash  # LLM that extracts the business summary +
#                                          # services from a scanned site.
# WIZARD_AGENT_MODEL=openrouter/google/gemini-2.5-flash      # Default chat model for trial agents
#                                          # (litellm format). A tier template can override it via model_name.
#                                          # Both default to Gemini Flash via OpenRouter (needs OPENROUTER_API_KEY).

# AWS (optional, for S3-compatible artifact storage)
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_BUCKET_NAME=test-bucket
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# LangSmith tracing (optional, langgraph runtime only — AGENT_FRAMEWORK=langgraph)
# Traces every run (graph steps, LLM prompts/responses, tool calls, tokens) to
# the LangSmith cloud UI at https://smith.langchain.com (Projects → LANGSMITH_PROJECT).
# NOTE: prompts and responses leave your infrastructure — prefer dev/staging only.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=mate
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com  # EU data residency (default: US)

# OpenTelemetry Distributed Tracing (optional)
# OTEL_TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_SERVICE_NAME=mate
# OTEL_TRACES_DB_EXPORT=true

# Context Compaction (requires ADK >= 1.16.0)
CONTEXT_COMPACTION_ENABLED=false
# CONTEXT_COMPACTION_INTERVAL=3
# CONTEXT_COMPACTION_OVERLAP_SIZE=1
# CONTEXT_COMPACTION_SUMMARIZER_MODEL=

# Resumability: pause/resume invocations, human-in-the-loop tool approval (requires ADK >= 2.0)
RESUMABILITY_ENABLED=false

# App-wide MATE plugin: RBAC/guardrails/token tracking as ADK Plugin instead of
# per-agent callbacks; covers all agents incl. runtime-created ones (requires ADK >= 2.0)
MATE_PLUGINS_ENABLED=false

DISTRIBUTION_DOMAIN=mate-static.example.com
DISTRIBUTION_S3_BUCKET_NAME=mate-prod-distribution
DISTRIBUTION_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com

MCP_EXPOSED_AGENTS=chess_mate_root

# Rate Limits & Budgets (optional)
# RATE_LIMIT_ENABLED=false
# REDIS_URL=redis://localhost:6379  # Optional: distributed rate limiting

# Audit log retention (EU AI Act compliance). 0 = keep forever; N = delete entries older than N days
# AUDIT_RETENTION_DAYS=0

# Temporary User Cleanup Configuration (deletes inactive widget and API users)
# CLEANUP_USER_ENABLED=true
# CLEANUP_USER_TTL_DAYS=5

# Email alerts and trigger notifications (SMTP)
# SMTP_HOST=                         # SMTP server for alert and trigger emails; empty disables sending
# SMTP_PORT=587                      # SMTP port (587 = STARTTLS)
# SMTP_USER=                         # SMTP login username
# SMTP_PASS=                         # SMTP login password
# SMTP_FROM=                         # From address (defaults to SMTP_USER)

# Scheduled alerts and triggers
# ALERTS_ENABLED=false               # Run the alert/trigger scheduler loop
# ALERTS_INTERVAL_SECONDS=60         # Scheduler tick interval in seconds (minimum 10)

# Agent evals (judge + improver)
# EVAL_JUDGE_MODEL=                  # Model used to judge agent runs (falls back below)
# EVAL_IMPROVE_MODEL=                # Model used to rewrite agents; falls back to EVAL_JUDGE_MODEL
# EVAL_REGRESSION_WEBHOOK_URL=       # POST target for eval regression reports

# Access control and AI disclosure
# ALLOWED_API_ROLES=                 # Comma-separated roles allowed to call the API (empty = configured default)
# MATE_AI_DISCLOSURE=                # Public AI-use disclosure text for standalone builds
# MATE_ALLOW_CODE_EXECUTOR_ON_WIDGET=false  # Allow the code executor tool on public widget agents

# Browser tool (headless Chromium via CDP)
# BROWSER_MODE=headless              # Browser automation mode
# BROWSER_HEADLESS=true              # Run Chromium headless
# BROWSER_CDP_URL=http://localhost:9222  # Chrome DevTools endpoint for browser sessions
# BROWSER_ALLOW_PRIVATE_NETWORK=false  # Allow the browser to reach private-network hosts

# Context cache (prompt caching for long contexts)
# CONTEXT_CACHE_MIN_TOKENS=2048      # Minimum context tokens before caching kicks in
# CONTEXT_CACHE_TTL_SECONDS=600      # Cached-context time to live in seconds
# CONTEXT_CACHE_INTERVALS=5          # Cache refresh interval count

# Pluggable services (database-backed by default)
# MEMORY_SERVICE=database            # Memory backend: database, file, or plugin name
# CREDENTIAL_SERVICE=database        # Credential backend: database, file, or plugin name
# DB_AUTO_CREATE_TABLES=true         # Create missing tables at startup
# DB_SKIP_SEED=                      # Set to true/1/yes to skip database seeding
# SESSION_DB_URL=sqlite+aiosqlite:///standalone_session.db  # Session store URL (standalone builds)

# Model providers and overrides
# GEMINI_API_KEY=                    # Google Gemini key (falls back to GOOGLE_API_KEY)
# GEMINI_MODEL=gemini-2.5-flash      # Default Gemini model
# MODEL_NAME=                        # Default model override for the OpenAI-compatible proxy
# MYSTERY_GEN_MODEL=                 # Model for the mystery-game generator (falls back to default)
# TITLE_GEN_MODEL=                   # Model for generated titles (falls back to default)
# OLLAMA_HOST=http://localhost:11434  # Ollama server for local models
# OPENAI_API_KEY_BACKUP=             # Fallback OpenAI key for the image tool
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1  # OpenRouter endpoint override
# GOOGLE_SERVICE_ACCOUNT_FILE=service-account-key.json  # Service-account key for Google tools
# TEMPLATES_REMOTE_URL=              # Remote template gallery URL (empty = bundled templates)

# Server ports
# PORT=8000                          # Main server bind port (langgraph entrypoint)

# Trial signup wizard
# WIZARD_CONTACT_EMAIL=sales@example.com  # Contact address shown during signup
# WIZARD_CURRENCY=EUR                # Default billing currency (ISO code)
# WIZARD_SHOP_CURRENCY=EUR           # Shop/checkout currency fallback
# WIZARD_CAPTCHA_PROVIDER=           # CAPTCHA provider for trial signup (empty = disabled)
# WIZARD_CLEANUP_ENABLED=true        # Periodically purge idle/expired wizard sessions
# WIZARD_SESSION_IDLE_HOURS=4        # Idle hours before a wizard session is purged
# WIZARD_CRAWL_MAX_DEPTH=3           # Max link depth when the wizard crawls a site
# WIZARD_CRAWL_MAX_PAGES=10          # Max pages per wizard crawl
# WIZARD_CRAWL_PAGE_TIMEOUT_MS=20000  # Per-page crawl timeout in milliseconds
# WIZARD_CRAWL_TIME_BUDGET_S=90      # Total crawl time budget in seconds
# WIZARD_TRIAL_TTL_DAYS=7            # Trial duration in days
# WIZARD_TRIAL_MAX_PAGES=5           # Max wizard pages per trial
# WIZARD_TIER3_TRIAL_TTL_DAYS=2      # Trial duration in days for tier 3

# Standalone builds only (ignored by the main server)
# ROOT_AGENT_NAME=                   # Root agent served by the standalone server
# STANDALONE_HOST=127.0.0.1          # Standalone server bind host
# STANDALONE_PORT=8080               # Standalone server bind port
# MATE_FEEDBACK_URL=                 # Standalone feedback endpoint base URL
# MATE_FEEDBACK_KEY=                 # API key for the standalone feedback endpoint

# Development only
# STUDIO_AGENT=                      # Agent loaded by the LangGraph Studio harness
# PRINT_CONTEXT_FEATURES_STATUS=true  # Log context-feature flags at agent startup
